# 1. Geometry: 4 corner points at Z=0
pnt p1 0 0 0
pnt p2 1 0 0
pnt p3 1 2 0
pnt p4 0 2 0

# 2. Lines with divisions (Nx=4, Ny=8)
line l1 p1 p2 4
line l2 p2 p3 8
line l3 p3 p4 4
line l4 p4 p1 8

# 3. Surface at Z=0
surf s0 l1 l2 l3 l4

# 4. Sweep into 3D body along Z (Nz=20 divisions, length=10)
swep all all tra 0 0 10 20

# 5. Set 20-node hex elements (C3D20)
elty all he20

# 6. Mesh
mesh all

# 7. Clamped set at Z=0
seta FIX s s0
seta NFIX n FIX

# 8. Corner vertices at free end Z=10
seta P0 p p1 p2 p3 p4
swep P0 P_EDGE tra 0 0 10
seta EDGE n P_EDGE

# 9. Free end face at Z=10 for tip load
seta TIP s A001
seta NTIP n TIP

# 10. Export CalculiX mesh & node sets
send all abq
send NFIX abq nam
send EDGE abq nam
send NTIP abq nam
